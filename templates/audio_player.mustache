{{!
    @template mod_dictogloss/audio_player
    Audio player(s) with an optional intro.

    Example context (json):
    {
        "label": "Listen again",
        "intro": "When ready, start the reconstruction.",
        "hasintro": true,
        "classes": "mb-4",
        "urls": ["https://example.com/pluginfile.php/1/mod_dictogloss/audio/0/text.mp3"]
    }
}}
<div class="mod-dictogloss-audio {{classes}}">
    <p>{{label}}</p>
    {{#hasintro}}<p class="text-muted">{{intro}}</p>{{/hasintro}}
    {{#urls}}
        <audio controls src="{{.}}"></audio>
    {{/urls}}
</div>
